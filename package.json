{
  "name": "craftscript",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --ext .tsx --ext .ts ./ --fix",
    "eslint": "eslint ./ --fix",
    "format": "prettier --write ./",
    "format:check": "prettier --check ./",
    "typecheck": "tsc --noEmit",
    "test": "node --test ci/smoke.test.mjs",
    "test:release-version": "node --test ci/check-version-bump.test.mjs",
    "check:release-version": "node ci/check-version-bump.mjs"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.12.0",
    "@tanstack/react-query": "^5.100.10",
    "@tanstack/react-query-devtools": "^5.100.10",
    "@types/node": "^20.19.41",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@vodis/ui-kit": "^1.0.15",
    "axios": "^1.16.1",
    "clsx": "^2.1.1",
    "formik": "^2.4.9",
    "js-cookie": "^3.0.7",
    "lodash": "^4.18.1",
    "next": "^13.5.11",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-dropzone": "^14.4.1",
    "react-redux": "^9.3.0",
    "react-toastify": "^9.1.3",
    "redux": "^5.0.1",
    "redux-thunk": "^3.1.0",
    "swiper": "^11.2.10",
    "typescript": "^5.9.3",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^13.5.11",
    "@rushstack/eslint-config": "^3.7.1",
    "@svgr/webpack": "^8.1.0",
    "@types/js-cookie": "^3.0.6",
    "@types/lodash": "^4.17.24",
    "@types/webpack-env": "^1.18.8",
    "autoprefixer": "^10.5.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^13.5.11",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "postcss": "^8.5.14",
    "prettier": "^3.8.3",
    "sass": "^1.99.0",
    "tailwindcss": "^3.4.19"
  },
  "lint-staged": {
    "*.{ts,tsx,js}": [
      "pnpm run lint",
      "pnpm run format"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  }
}
